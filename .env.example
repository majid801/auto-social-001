# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLORA_API_KEY: Required for official Publora Instagram publishing & connection.
# Users configure this via the Secrets panel in the AI Studio UI.
PUBLORA_API_KEY="MY_PUBLORA_API_KEY"

# The Firebase project ID used to validate Firebase ID tokens.
FIREBASE_PROJECT_ID="sublime-ruler-kt3g1"

# Optional persistent paths. For Railway, mount a volume at /data and set both values below.
DATA_DIR="/data"
UPLOADS_DIR="/data/uploads"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and deployment configuration.
APP_URL="MY_APP_URL"
