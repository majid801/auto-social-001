# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLORA_API_KEY: Required for official Publora Instagram publishing & connection.
# Users configure this via the Secrets panel in the AI Studio UI.
PUBLORA_API_KEY="MY_PUBLORA_API_KEY"

# Set MEDIA_GENERATION_PROVIDER=free-aistudio to route Image Generator and Reels Studio
# requests through the authenticated Kaggle GPU bridge instead of Gemini image/video APIs.
# Worker URL, token, and media-session secret stay on the server; never use VITE_ prefixes.
MEDIA_GENERATION_PROVIDER="gemini"
OPEN_GPU_WORKER_URL="https://YOUR-ACTIVE-KAGGLE-TUNNEL.trycloudflare.com"
OPEN_GPU_WORKER_TOKEN="REPLACE_WITH_TOKEN_PRINTED_BY_THE_ACTIVE_NOTEBOOK"
MEDIA_SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_GENERATED_LOCALLY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
